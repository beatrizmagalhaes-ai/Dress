<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="gamePane" 
            prefHeight="1080.0" 
            prefWidth="1600.0" 
            styleClass="game-root"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.jogo.GameController">
            
    <children>
        <!-- 1. Botão VOLTAR -->
        <Button fx:id="btnVoltar" 
                layoutX="120.0" 
                layoutY="55.0" 
                onAction="#voltarParaSelecao" 
                prefHeight="110.0" 
                prefWidth="110.0" 
                styleClass="invisible-btn" />

        <!-- 2. Contador de MOEDAS -->
        <Label fx:id="lblMoedas" 
               layoutX="1285.0" 
               layoutY="80.0" 
               prefHeight="60.0" 
               prefWidth="180.0" 
               styleClass="moedas-label" 
               text="0" />

        <!-- 3. MARIANA NO PEDESTAL (Centralizada no meio do pedestal) -->
        <ImageView fx:id="imgPersonagem" 
                   fitHeight="560.0" 
                   fitWidth="280.0" 
                   layoutX="225.0" 
                   layoutY="310.0" 
                   pickOnBounds="true" 
                   preserveRatio="true" />

        <!-- 4. Abas do Guarda-Roupa -->
        <HBox layoutX="705.0" layoutY="260.0" spacing="16.0">
            <children>
                <Button fx:id="btnVestidos" onAction="#mostrarVestidos" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="VESTIDOS" />
                <Button fx:id="btnBlusas" onAction="#mostrarBlusas" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="BLUSAS" />
                <Button fx:id="btnCalcas" onAction="#mostrarCalcas" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="CALÇAS" />
                <Button fx:id="btnAcessorios" onAction="#mostrarAcessorios" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="ACESSÓRIOS" />
                <Button fx:id="btnSapatos" onAction="#mostrarSapatos" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="SAPATOS" />
                <Button fx:id="btnSairLoja" onAction="#sairOuAbrirLoja" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="LOJA" />
            </children>
        </HBox>

        <!-- 5. Guarda-Roupa Transparente -->
        <ScrollPane layoutX="680.0" layoutY="340.0" prefHeight="480.0" prefWidth="750.0" styleClass="guarda-roupa-scroll">
            <content>
                <GridPane fx:id="gridItens" hgap="20.0" vgap="20.0" styleClass="guarda-roupa-grid" />
            </content>
        </ScrollPane>

        <!-- 6. Botão SALVAR LOOK -->
        <Button fx:id="btnSalvarLook" 
                layoutX="840.0" 
                layoutY="840.0" 
                onAction="#salvarLook" 
                prefHeight="60.0" 
                prefWidth="430.0" 
                styleClass="salvar-btn" 
                text="SALVAR LOOK" />
    </children>
</AnchorPane>