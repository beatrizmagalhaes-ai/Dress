<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="gamePane" 
            prefHeight="1080.0" 
            prefWidth="1600.0" 
            styleClass="game-root"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.jogo.GameController">
            
    <children>
        <!-- 1. Botão VOLTAR -->
        <Button fx:id="btnVoltar" 
                layoutX="120.0" 
                layoutY="55.0" 
                onAction="#voltarParaSelecao" 
                prefHeight="110.0" 
                prefWidth="110.0" 
                styleClass="invisible-btn" />

        <!-- 2. Contador de MOEDAS -->
        <Label fx:id="lblMoedas" 
               layoutX="1285.0" 
               layoutY="80.0" 
               prefHeight="60.0"  
               prefWidth="180.0" 
               styleClass="moedas-label" 
               text="0" />

        <!-- 3. PERSONAGEM NO PEDESTAL (Vale para Mariana, Mayara, Beatriz e Marco) -->
        <ImageView fx:id="imgPersonagem" 
                   fitHeight="560.0" 
                   fitWidth="280.0" 
                   layoutX="258.0" 
                   layoutY="348.0" 
                   pickOnBounds="true" 
                   preserveRatio="true" />

        <!-- 3.1 SAPATO SOBREPOSTO NO CORPO -->
        <ImageView fx:id="imgSapatoEquipado" 
                   fitHeight="560.0" 
                   fitWidth="280.0" 
                   layoutX="258.0" 
                   layoutY="348.0" 
                   mouseTransparent="true"
                   pickOnBounds="true" 
                   preserveRatio="true" />

        <!-- 3.2 CALÇA SOBREPOSTA NO CORPO -->
        <ImageView fx:id="imgCalcaEquipada" 
                   fitHeight="560.0" 
                   fitWidth="280.0" 
                   layoutX="258.0" 
                   layoutY="348.0" 
                   mouseTransparent="true"
                   pickOnBounds="true" 
                   preserveRatio="true" />

        <!-- 3.3 BLUSA OU VESTIDO SOBREPOSTO NO CORPO -->
        <ImageView fx:id="imgRoupaEquipada" 
                   fitHeight="560.0" 
                   fitWidth="280.0" 
                   layoutX="258.0" 
                   layoutY="348.0" 
                   mouseTransparent="true"
                   pickOnBounds="true" 
                   preserveRatio="true" />

        <!-- 3.4 ACESSÓRIO SOBREPOSTO NO CORPO -->
        <ImageView fx:id="imgAcessorioEquipado" 
                   fitHeight="560.0" 
                   fitWidth="280.0" 
                   layoutX="258.0" 
                   layoutY="348.0" 
                   mouseTransparent="true"
                   pickOnBounds="true" 
                   preserveRatio="true" />

        <!-- 4. Abas do Guarda-Roupa -->
        <Button fx:id="btnVestidos" alignment="CENTER" layoutX="702.0" layoutY="265.0" onAction="#mostrarVestidos" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="VESTIDOS" />
        <Button fx:id="btnBlusas" alignment="CENTER" layoutX="822.0" layoutY="265.0" onAction="#mostrarBlusas" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="BLUSAS" />
        <Button fx:id="btnCalcas" alignment="CENTER" layoutX="942.0" layoutY="265.0" onAction="#mostrarCalcas" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="CALÇAS" />
        <Button fx:id="btnAcessorios" alignment="CENTER" layoutX="1062.0" layoutY="265.0" onAction="#mostrarAcessorios" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="ACESSÓRIOS" />
        <Button fx:id="btnSapatos" alignment="CENTER" layoutX="1182.0" layoutY="265.0" onAction="#mostrarSapatos" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="SAPATOS" />
        <Button fx:id="btnSairLoja" alignment="CENTER" layoutX="1302.0" layoutY="265.0" onAction="#sairOuAbrirLoja" prefHeight="55.0" prefWidth="105.0" styleClass="aba-btn" text="LOJA" />

        <!-- 5. Guarda-Roupa: 6 Slots Posicionados no Centro de Cada Moldura -->
        <!-- LINHA DE CIMA (Y = 365) -->
        <Button alignment="CENTER" layoutX="705.0" layoutY="365.0" onAction="#equiparSlot1" prefHeight="195.0" prefWidth="215.0" styleClass="slot-btn">
            <graphic>
                <ImageView fx:id="imgSlot1" fitHeight="160.0" fitWidth="180.0" preserveRatio="true" />
            </graphic>
        </Button>

        <Button alignment="CENTER" layoutX="972.0" layoutY="365.0" onAction="#equiparSlot2" prefHeight="195.0" prefWidth="215.0" styleClass="slot-btn">
            <graphic>
                <ImageView fx:id="imgSlot2" fitHeight="160.0" fitWidth="180.0" preserveRatio="true" />
            </graphic>
        </Button>

        <Button alignment="CENTER" layoutX="1256.0" layoutY="365.0" onAction="#equiparSlot3" prefHeight="195.0" prefWidth="215.0" styleClass="slot-btn">
            <graphic>
                <ImageView fx:id="imgSlot3" fitHeight="160.0" fitWidth="180.0" preserveRatio="true" />
            </graphic>
        </Button>

        <!-- LINHA DE BAIXO (Y = 620) -->
        <Button alignment="CENTER" layoutX="705.0" layoutY="620.0" onAction="#equiparSlot4" prefHeight="195.0" prefWidth="215.0" styleClass="slot-btn">
            <graphic>
                <ImageView fx:id="imgSlot4" fitHeight="160.0" fitWidth="180.0" preserveRatio="true" />
            </graphic>
        </Button>

        <Button alignment="CENTER" layoutX="972.0" layoutY="620.0" onAction="#equiparSlot5" prefHeight="195.0" prefWidth="215.0" styleClass="slot-btn">
            <graphic>
                <ImageView fx:id="imgSlot5" fitHeight="160.0" fitWidth="180.0" preserveRatio="true" />
            </graphic>
        </Button>

        <Button alignment="CENTER" layoutX="1256.0" layoutY="620.0" onAction="#equiparSlot6" prefHeight="195.0" prefWidth="215.0" styleClass="slot-btn">
            <graphic>
                <ImageView fx:id="imgSlot6" fitHeight="160.0" fitWidth="180.0" preserveRatio="true" />
            </graphic>
        </Button>

        <!-- 6. Botão SALVAR LOOK -->
        <Button fx:id="btnSalvarLook" 
                layoutX="840.0" 
                layoutY="840.0" 
                onAction="#salvarLook" 
                prefHeight="60.0" 
                prefWidth="430.0" 
                styleClass="salvar-btn" 
                text="SALVAR LOOK" />
    </children>
</AnchorPane>