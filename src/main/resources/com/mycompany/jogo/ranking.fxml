<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.RankingController">

   <children>
      <!-- IMAGEM DE FUNDO - AGORA NÃO CORTA MAIS -->
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@ranking_fundo.png" />
         </image>
      </ImageView>

      <!-- Botão invisível em cima da setinha -->
      <Button layoutX="15.0" layoutY="15.0" mnemonicParsing="false" onAction="#voltarParaMenu" opacity="0.0" prefHeight="110.0" prefWidth="120.0" style="-fx-cursor: hand;" text="voltar" />
   </children>
</AnchorPane>