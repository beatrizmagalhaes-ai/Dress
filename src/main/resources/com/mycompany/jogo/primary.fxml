<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="rootPane" 
            prefHeight="1080.0" 
            prefWidth="1600.0" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.jogo.PrimaryController">
            
    <children>
        <!-- Caixa 1: JOGAR (Subiu para 345) -->
        <Button fx:id="btnJogar" 
                layoutX="1080.0" 
                layoutY="345.0" 
                onAction="#switchToSecondary" 
                prefHeight="85.0" 
                prefWidth="315.0" 
                styleClass="transparent-btn" 
                text="JOGAR" />

        <!-- Caixa 2: RANKING (Subiu para 505) -->
        <Button fx:id="btnRanking" 
                layoutX="1080.0" 
                layoutY="505.0" 
                onAction="#abrirRanking" 
                prefHeight="85.0" 
                prefWidth="315.0" 
                styleClass="transparent-btn" 
                text="RANKING" />

        <!-- Caixa 3: CRÉDITOS (Subiu para 665) -->
        <Button fx:id="btnCreditos" 
                layoutX="1080.0" 
                layoutY="665.0" 
                onAction="#abrirCreditos" 
                prefHeight="85.0" 
                prefWidth="315.0" 
                styleClass="transparent-btn" 
                text="CRÉDITOS" />

        <!-- Caixa 4: ENCERRAR (Subiu para 825) -->
        <Button fx:id="btnEncerrar" 
                layoutX="1080.0" 
                layoutY="825.0" 
                onAction="#encerrarJogo" 
                prefHeight="85.0" 
                prefWidth="315.0" 
                styleClass="transparent-btn" 
                text="ENCERRAR" />
    </children>
</AnchorPane>