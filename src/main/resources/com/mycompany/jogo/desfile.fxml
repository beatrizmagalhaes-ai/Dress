<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="desfilePane" prefHeight="1080.0" prefWidth="1600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.DesfileController">
   <children>
      <!-- Container que move o personagem e a roupa juntos na passarela -->
      <StackPane fx:id="containerAvatar" layoutX="600.0" layoutY="200.0" prefHeight="650.0" prefWidth="400.0">
         <children>
            <ImageView fx:id="imgPersonagemDesfile" fitHeight="650.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="imgRoupaDesfile" fitHeight="650.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>

      <!-- Painel de Resultado -->
      <VBox alignment="CENTER" layoutX="1080.0" layoutY="300.0" prefHeight="350.0" prefWidth="420.0" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 20; -fx-padding: 25;">
         <children>
            <Label text="RESULTADO DO DESFILE">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Label fx:id="lblMensagemJurados" text="Avaliando look..." textAlignment="CENTER" wrapText="true">
               <font><Font size="16.0" /></font>
            </Label>
            <Label fx:id="lblPontuacao" text="Pontos de Estilo: ..." textFill="#9b287b">
               <font><Font name="System Bold" size="20.0" /></font>
            </Label>
            <Label fx:id="lblMoedasGanhas" text="Moedas Ganhas: ..." textFill="#d49b00">
               <font><Font name="System Bold" size="20.0" /></font>
            </Label>
            <Button onAction="#voltarParaVestiario" prefHeight="45.0" prefWidth="250.0" text="Voltar ao Vestiário" />
            <Button onAction="#irParaRanking" prefHeight="45.0" prefWidth="250.0" text="Ver Ranking" />
         </children>
      </VBox>
   </children>
</AnchorPane>
