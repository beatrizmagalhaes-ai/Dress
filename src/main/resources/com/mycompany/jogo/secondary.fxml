<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="secondaryPane" 
            prefHeight="1080.0" 
            prefWidth="1600.0" 
            styleClass="secondary-root"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.jogo.SecondaryController">
            
    <children>
        <!-- Botão 1: MARIANA -->
        <Button fx:id="btnMariana" 
                layoutX="100.0" 
                layoutY="944.0" 
                onAction="#selecionarMariana" 
                prefHeight="60.0" 
                prefWidth="200.0" 
                styleClass="personagem-btn" 
                text="MARIANA" />

        <!-- Botão 2: MAYARA -->
        <Button fx:id="btnMayara" 
                layoutX="500.0" 
                layoutY="944.0" 
                onAction="#selecionarMayara" 
                prefHeight="60.0" 
                prefWidth="200.0" 
                styleClass="personagem-btn" 
                text="MAYARA" />

        <!-- Botão 3: BEATRIZ -->
        <Button fx:id="btnBeatriz" 
                layoutX="900.0" 
                layoutY="944.0" 
                onAction="#selecionarBeatriz" 
                prefHeight="60.0" 
                prefWidth="200.0" 
                styleClass="personagem-btn" 
                text="BEATRIZ" />

        <!-- Botão 4: MARCO -->
        <Button fx:id="btnMarco" 
                layoutX="1300.0" 
                layoutY="944.0" 
                onAction="#selecionarMarco" 
                prefHeight="60.0" 
                prefWidth="200.0" 
                styleClass="personagem-btn" 
                text="MARCO" />
    </children>
</AnchorPane>